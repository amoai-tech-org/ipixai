# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright — https://playwright.dev/docs/test-configuration
/playwright/.auth/
/playwright-report/
/blob-report/
/test-results/
/.playwright-cli/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local IDE
.idea/

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.agent.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.mastra/

# Graphify generated local analysis state
graphify-out/


# Local Mastra/CopilotKit reference clones (see github/mastra/mastra-repos.md)
/github/mastra/clones/
supabase/.temp/
# Playwright CLI output (may contain credentials)
.playwright-cli/

# reference-library candidate binaries + working manifest (operator-local; never committed)
# keep scripts/reference-library/manifest.example.json tracked as the documented shape
/assets/reference-candidates/
/scripts/reference-library/manifest.json

# Codacy local generated analysis config
/.codacy/

# Kilo Code agent-manager state and worktrees. `.kilo/worktrees/<name>/` is a
# full nested checkout (its own AGENTS.md, .claude/, node_modules), so an
# unignored copy is a repo-in-a-repo waiting to be committed by accident.
# Previously this was excluded only via .git/info/exclude, which git does not
# share between clones — a fresh clone had no protection at all.
/.kilo/
