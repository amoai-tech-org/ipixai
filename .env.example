# Dotenvx is the local env loader. Real .env* files stay gitignored.
# .env.local = local app/runtime; .env.test = E2E/QA; .env.agent = least-privilege coding-agent credentials.
# Production/deployment secrets remain in their provider secret stores; this file is names/documentation only.
# Dotenvx private keys (.env.keys / DOTENV_PRIVATE_KEY*) must never be committed.

# Copy relevant entries to .env.local locally. Never commit real keys.
OPENAI_API_KEY=
COPILOTKIT_TELEMETRY_DISABLED=true

# Product Planner runtime (IPI-1329 · MASTRA-INPROC-001): /api/copilotkit
# ALWAYS runs the Production Planner in-process (createLocalAgents) with
# durable threads in Supabase/Postgres (MASTRA_DATABASE_URL only — see below).
# It does NOT read CPK_INTELLIGENCE_API_KEY, COPILOTKIT_API_KEY,
# INTELLIGENCE_API_URL, INTELLIGENCE_GATEWAY_WS_URL or MASTRA_BASE_URL —
# setting them cannot switch the Planner to managed Intelligence or a remote
# Mastra service. Leave them unset for the Product app.
# MASTRA_BASE_URL is only read by the legacy remote-Mastra helpers in
# src/agent.ts / mastra-control-runner.ts (tests + rollback reference until
# IPI-1334 · MASTRA-REMOTE-CLEANUP-001). Server-only; never NEXT_PUBLIC_*.
# MASTRA_BASE_URL=http://127.0.0.1:4111
# Standalone Mastra server Supabase Auth (IPI-1308) only. When that separate
# server runs with IPIX_MASTRA_HOSTED=1, use server-only SUPABASE_URL +
# SUPABASE_PUBLISHABLE_KEY (HTTPS + publishable key; never secret/service-role).
# The in-process Product Planner uses the verified Next session and may use the
# NEXT_PUBLIC_* pair below via resolveSupabaseUserAuthConfig().
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Public Supabase Auth (browser-safe). Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Playwright E2E QA accounts (real values belong only in .env.test / CI secrets).
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_EMAIL_ORG_B=
E2E_TEST_PASSWORD_ORG_B=
# Populated QA org used by Shoots, Dashboard, and Planner-context E2E tests; its org must already contain test brands and shoots.
E2E_TEST_EMAIL_SHOOTS=
E2E_TEST_PASSWORD_SHOOTS=
# Optional. Blank = Playwright starts its own localhost:3015 server. Only localhost or an iPix Vercel Preview is accepted.
E2E_BASE_URL=
# Optional. Only exact `production` uses the prebuilt `npm run build` output; blank or any other value uses the dev server.
E2E_SERVER=
# Optional live-write Brand Intelligence journey (e2e/brand-intelligence-journey.spec.ts):
# a dedicated QA brand id plus explicit opt-in (=1); otherwise the journey is skipped.
E2E_BRAND_INTEL_BRAND_ID=
E2E_BRAND_INTEL_ALLOW_WRITES=

# Server-only Supabase. Never NEXT_PUBLIC_*.
# Preferred modern backend key map (JSON; use the named `default` secret key).
# SUPABASE_SECRET_KEYS={"default":"sb_secret_..."}
# Legacy compatibility only:
# SUPABASE_SERVICE_ROLE_KEY=

# Local Postgres only (opt-in). Hosts outside the allowlist are rejected.
# Copy the URI from `supabase status` after `supabase start` (CLI default is
# 127.0.0.1:54322). A local Docker publish on 54342 is also allowed.
# Omit this and Planner chat stays in RAM (LibSQL).
# MASTRA_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres

# Hosted preview/runtime (IPI-1124). Never set this locally unless you intend
# fail-closed Postgres (no LibSQL). Pair with a Dashboard URI for fashionos
# only: user hyperdrive_mastra_runtime (or user.project-ref on the pooler).
# Prefer transaction pooler port 6543; session 5432 only if transaction fails.
# IPIX_MASTRA_HOSTED=1
# MASTRA_DATABASE_URL=postgresql://hyperdrive_mastra_runtime.[PROJECT_REF]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Cloudinary (IPI-1108 · CLD-FOUNDATION-001)
# Public cloud name is ipix-cloudinary (not a secret).
# CLOUDINARY_API_SECRET is server-only — never NEXT_PUBLIC_* and never
# import src/lib/cloudinary/config.ts from Client Components.
# ai_powerstart = unsigned Cloudinary Power Start validation preset only.
# Never use ai_powerstart for production operator uploads.
# Production uploads = signed iPix flow (IPI-1110 · CLD-SIGN-001 +
# IPI-1116 · CLD-UPLOAD-001).
# Approval must never make authenticated DAM assets public.
CLOUDINARY_CLOUD_NAME=ipix-cloudinary
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Consume-only signed upload preset (IPI-1112 owns eager/named transforms).
# Defaults to ipix-signed-upload when unset. Never ai_powerstart.
CLOUDINARY_SIGNED_UPLOAD_PRESET=ipix-signed-upload
# Optional dedicated webhook verification secret (IPI-1111). Falls back to API secret.
# CLOUDINARY_NOTIFICATION_API_SECRET=

# Browser-safe (next-cloudinary). Cloud name only — no API secret.
# The sign route also returns api_key for prepareUploadParams.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ipix-cloudinary
